{
  "name": "immoapp",
  "private": true,
  "version": "1.0.0",
  "description": "ImmoApp – rechnerische Preisermittlung und Liegenschaften (Preiseinschätzung nach Vordruck) als statische PWA (Build nur für den Service Worker)",
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "test:e2e": "playwright test",
    "test:alle": "node --test \"tests/unit/*.test.mjs\" && playwright test",
    "serve": "node tests/server.mjs",
    "build": "node scripts/build.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "klicktest": "node tests/klick/klicktest.mjs desktop",
    "klicktest:iphone": "node tests/klick/klicktest.mjs iphone"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=22"
  }
}
